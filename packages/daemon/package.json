{
  "name": "@armada/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Armada V2 local event log and pure fleet projections.",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./fold": "./src/fold.ts",
    "./store": "./src/store.ts",
    "./keychain": "./src/keychain.ts",
    "./credentials": "./src/credentials.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "start": "node src/server/main.ts"
  },
  "dependencies": {
    "@armada/protocol": "workspace:*",
    "@napi-rs/keyring": "2.1.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  },
  "bin": {
    "armadad": "./src/server/main.ts"
  }
}
