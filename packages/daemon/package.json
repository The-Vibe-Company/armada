{
  "name": "@armada/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Armada V2 local event log and pure fleet projections.",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./fold": "./src/fold.ts",
    "./store": "./src/store.ts",
    "./keychain": "./src/keychain.ts",
    "./credentials": "./src/credentials.ts",
    "./server": "./src/server/index.ts",
    "./coordinator": "./coordinator/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./plugins/list": "./src/plugins/list.ts",
    "./plugins/catalog": "./src/plugins/catalog.ts",
    "./plugins/config": "./src/plugins/config.ts"
  },
  "scripts": {
    "test": "bun ../../scripts/bundle-skills.ts && bun ../../scripts/bundle-test-support.ts && node --test test/*.test.ts ../plugins/linear/test/*.test.ts ../plugins/github/test/*.test.ts ../plugins/conductor/test/*.test.ts",
    "start": "node src/server/main.ts"
  },
  "dependencies": {
    "@armada/protocol": "workspace:*",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@napi-rs/keyring": "2.1.2",
    "typebox": "1.3.27",
    "ws": "8.21.3",
    "@armada/plugin-api": "workspace:*",
    "ajv": "8.20.0",
    "semver": "7.7.4",
    "proper-lockfile": "4.1.2",
    "ai": "7.0.156",
    "zod": "4.6.5",
    "smol-toml": "1.9.0",
    "@armada/core": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@types/semver": "7.7.1",
    "@types/proper-lockfile": "4.1.4"
  },
  "bin": {
    "armadad": "./src/server/main.ts"
  }
}
