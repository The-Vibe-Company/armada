{
  "name": "@armada/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Armada V2 local event log and pure fleet projections.",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./fold": "./src/fold.ts",
    "./store": "./src/store.ts",
    "./server": "./src/server/index.ts",
    "./coordinator": "./coordinator/index.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "start": "node src/server/main.ts"
  },
  "dependencies": {
    "@armada/protocol": "workspace:*",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "typebox": "1.3.27",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  },
  "bin": {
    "armadad": "./src/server/main.ts"
  }
}
