{
  "name": "@the-vibe-company/armada",
  "version": "0.1.17",
  "type": "module",
  "description": "Run a fleet of coding agents on one project: the armada command line.",
  "license": "MIT",
  "homepage": "https://github.com/The-Vibe-Company/armada#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Vibe-Company/armada.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/The-Vibe-Company/armada/issues",
  "keywords": [
    "agents",
    "coding-agents",
    "linear",
    "github",
    "cli"
  ],
  "bin": {
    "armada": "dist/armada.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target node --external @libsql/client --outfile dist/armada.js",
    "prepack": "bun run build && cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  },
  "devDependencies": {
    "@armada/core": "workspace:*"
  }
}
