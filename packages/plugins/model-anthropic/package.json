{
  "name": "@armada/plugin-model-anthropic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "armada": {
    "id": "model-anthropic",
    "version": "0.1.0",
    "pluginApi": "^0.1.0",
    "enabledByDefault": true,
    "description": "Anthropic models for the coordinator.",
    "contributions": {
      "model": {
        "anthropic": {
          "description": "Anthropic",
          "config": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              },
              "baseURL": {
                "type": "string",
                "minLength": 1
              },
              "apiKeySecret": {
                "type": "string",
                "enum": [
                  "ANTHROPIC_API_KEY",
                  "ARMADA_MODEL_API_KEY"
                ]
              }
            },
            "additionalProperties": false
          },
          "secrets": [
            "ANTHROPIC_API_KEY",
            "ARMADA_MODEL_API_KEY"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.92",
    "@armada/plugin-api": "workspace:*",
    "zod": "4.6.5"
  }
}
