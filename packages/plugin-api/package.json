{
  "name": "@armada/plugin-api",
  "version": "0.2.0",
  "type": "module",
  "description": "Versioned Armada plugin manifests and provider contracts.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "default": "./dist/guard.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  }
}
