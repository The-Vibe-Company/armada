# Required server environment (checked at startup by config.ts and startup-configuration.ts).
# Never commit real credentials; fill local values in an untracked .env file.
ARMADA_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
ARMADA_AUTH_SECRET=
ARMADA_PUBLIC_URL=
ARMADA_ENCRYPTION_KEY=

# Required runtime artifact settings (Modal dial-out and installed runtime manifests).
ARMADA_MODAL_DIALOUT=1
ARMADA_MODAL_RUNTIME_MANIFEST=
ARMADA_RUNTIME_ARTIFACT_DIR=
# Optional override; defaults to /opt/armada/runtime-manifests/<arch>.json.
ARMADA_BOAT_RUNTIME_MANIFEST=

# Optional server tuning and local development origins.
PORT=8080
NODE_ENV=development
ARMADA_DASHBOARD_URL=
ARMADA_DATABASE_POOL_MAX=
ARMADA_AUTH_PROVIDERS=
ARMADA_SANDBOX_EXTENSION_HEADROOM_SECONDS=
ARMADA_RUNTIME_IDLE_MINUTES=
ARMADA_BOAT_DEPLOYMENT_ID=

# Optional Docker host placement (ARMADA_DOCKER_RUNTIME_MANIFEST is required when both flags are 1).
ARMADA_DOCKER_HOSTS=
ARMADA_DOCKER_PLACEMENT=
ARMADA_DOCKER_RUNTIME_MANIFEST=

# Optional CLI device login (requires matching ARMADA_CLI_CONSENT_KEY on apps/dashboard).
ARMADA_CLI_OAUTH_CLIENT_ID=
ARMADA_CLI_OAUTH_CLIENT_SECRET=
ARMADA_CLI_CONSENT_KEY=

# Optional invitation email delivery ("supabase" enables Supabase email delivery).
ARMADA_INVITATION_MAIL=

# Optional GitHub App integration (snapshot builds and sandbox GitHub identity).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional encrypted integrations (sealed with ARMADA_ENCRYPTION_KEY).
ARMADA_SLACK_MCP_CLIENT_ENC=
ARMADA_SCRIPTED_MODEL=
ARMADA_SCRIPTED_MODEL_BEARER_ENC=
