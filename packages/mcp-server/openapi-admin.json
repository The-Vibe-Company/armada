  "paths": {
    "/api/v1/token/list": {
      "post": {
        "operationId": "token_list",
        "description": "List the caller's service tokens in their current scope, without token values or hashes.",
        "security": [
          {
            "serviceToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "properties": {
                    "tokens": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "orgName": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "revokedAt": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "orgName",
                          "createdAt",
                          "revokedAt"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "tokens"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable: a structured failure, or the bare refusal sent before dispatch while the server drains. Honor Retry-After when present.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Failure"
                    },
                    {
                      "$ref": "#/components/schemas/DrainRefusal"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Administrative API failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/token/create": {
      "post": {
        "operationId": "token_create",
        "description": "Create a service token for an organization in the caller's scope. The token value is returned only once.",
        "security": [
          {
            "serviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Send at most 131072 bytes of serialized JSON. The dashboard endpoint refuses a larger body with HTTP 413 without forwarding it, and the server refuses a body over its own limit, which is never lower, with HTTP 413 before any handler runs.",
          "x-max-body-bytes": 131072,
          "x-oversized-body-status": 413,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "type": "object",
                "properties": {
                  "org": {
                    "description": "Organization UUID or name. Required for scoped callers unless orgName is supplied.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "orgName": {
                    "description": "Organization name or UUID. If both selectors are supplied, they must match.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label": {
                    "description": "Defaults to default when missing, null, or empty. A supplied label is trimmed and must then contain 1–80 characters and no ASCII control characters.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "orgName": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "orgName",
                    "token"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "413": {
            "description": "The serialized request body exceeds 131072 bytes. Nothing was dispatched.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable: a structured failure, or the bare refusal sent before dispatch while the server drains. Honor Retry-After when present.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Failure"
                    },
                    {
                      "$ref": "#/components/schemas/DrainRefusal"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Administrative API failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
