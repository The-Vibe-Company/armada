# Supabase project (public: the browser never gets more than the anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Social login buttons to show, comma separated: github, google. Empty: email only.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Armada MCP server (Railway). Without it the dashboard still lists sandboxes but
# cannot read their live logs or stop / message them.
ARMADA_MCP_URL=

# 32 random bytes, base64 (`openssl rand -base64 32`). @armada/core seals
# credentials with AES-256-GCM (the same ARMADA_ENCRYPTION_KEY #461 uses).
# Server only, and set for the Next.js build: without it the dashboard refuses
# to store a credential.
ARMADA_ENCRYPTION_KEY=

# The Armada GitHub App (user authorization), for "Connect GitHub" in Settings. Server only.
# Client ID and secret come from the app's settings page on GitHub. The slug is the last part of
# https://github.com/apps/<slug>: Connect sends the person there when they have no installation.
# GITHUB_APP_ID is the numeric App ID, not the client id. Set it only to require that match too.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_ID=

# Server-only /api/stats bearer and privileged Postgres connection for auth.users counts.
# Never use these in the signed-in Supabase browser client.
STATS_TOKEN=
ARMADA_DATABASE_URL=
