{
  "name": "armada",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "armada": "bun packages/cli/src/main.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/dashboard",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "db:types": "bun scripts/db/render.ts",
    "dashboard": "bun run --filter @armada/dashboard dev",
    "dashboard:build": "bun run --filter @armada/dashboard build",
    "e2e": "bun run --filter @armada/dashboard e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.3.14",
    "@types/bun": "1.3.14",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
