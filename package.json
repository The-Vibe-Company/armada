{
  "name": "armada-monorepo",
  "version": "0.2.62",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "skills:bundle": "bun scripts/bundle-skills.ts",
    "armada": "bun run skills:bundle && bun packages/cli/src/main.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run skills:bundle && tsc --noEmit && tsc --noEmit -p packages/dashboard",
    "test": "bun test",
    "verify": "bun run lint && bun run typecheck && bun test",
    "test:browser:install": "bun run --cwd packages/dashboard test:browser:install",
    "postinstall": "bun run skills:bundle",
    "build": "bun run --cwd packages/cli build && bun run --cwd packages/dashboard build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.14",
    "@types/picomatch": "4.0.2",
    "typescript": "5.9.3"
  }
}
