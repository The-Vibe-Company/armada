{
  "name": "armada-monorepo",
  "version": "0.2.56",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "skills:bundle": "bun scripts/bundle-skills.ts",
    "armada": "bun packages/cli/src/main.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/dashboard",
    "test": "bun test && bun run test:browser",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "test:browser": "node --experimental-strip-types --test --test-concurrency=1 packages/dashboard/test/*.browser.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.14",
    "@types/picomatch": "4.0.2",
    "typescript": "5.9.3"
  }
}
