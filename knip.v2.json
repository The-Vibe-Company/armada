{
  "$schema": "https://unpkg.com/knip@6.43.0/schema.json",
  "workspaces": {
    ".": {
      "entry": ["e2e.config.ts", "e2e/prepare.ts", "e2e/**/*.test.ts", "e2e/tests/**/*.e2e.ts"],
      "project": ["e2e/**/*.ts"],
      "ignoreDependencies": ["@types/picomatch", "@types/proper-lockfile"],
      "typescript": false
    },
    "packages/protocol": {
      "entry": ["test/**/*.test.mjs"],
      "project": ["src/**/*.ts", "test/**/*.mjs"]
    },
    "packages/daemon": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "coordinator/**/*.ts", "test/**/*.ts"]
    },
    "packages/app": {
      "entry": [
        "test/**/*.test.{ts,tsx}",
        "test/notify-page.tsx",
        "test/room-live-page.tsx",
        "test/thread-page.tsx",
        "test/sidebar-page.tsx",
        "test/thread-scroll-page.tsx"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts", "test/**/*.{ts,tsx}"]
    },
    "packages/desktop": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/plugin-api": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugins/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugins/linear": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/plugins/github": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/plugins/node-local": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignoreWorkspaces": ["packages/core", "packages/cli", "packages/dashboard"],
  "github-actions": false,
  "bun": false
}
